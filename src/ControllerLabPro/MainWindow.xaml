<Window x:Class="ControllerLabPro.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ControllerLab Pro" Width="1220" Height="780" MinWidth="980" MinHeight="650" WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#0E1527"><DockPanel Margin="18"><StackPanel DockPanel.Dock="Top"><TextBlock Text="CONTROLLERLAB" FontWeight="Bold" FontSize="20"/><TextBlock Text="PRO • OFFLINE LAB" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,2,0,28"/>
   <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0" Foreground="White" SelectionChanged="NavChanged"><ListBoxItem Content="Dashboard" Padding="12" IsSelected="True"/><ListBoxItem Content="Sticks &amp; Jitter" Padding="12"/><ListBoxItem Content="Turbo &amp; Remap" Padding="12"/><ListBoxItem Content="Vision Aim" Padding="12"/><ListBoxItem Content="Monitor" Padding="12"/><ListBoxItem Content="Profiles" Padding="12"/></ListBox>
  </StackPanel><StackPanel DockPanel.Dock="Bottom"><TextBlock x:Name="InputStatus" Text="DualSense: disconnected" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4"/><TextBlock x:Name="OutputStatus" Text="Game output: disconnected" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4"/><Button x:Name="ControllerButton" Content="START CONTROLLER" Click="StartController" Margin="0,12,0,0"/></StackPanel></DockPanel></Border>
  <Grid Grid.Column="1" Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><DockPanel Margin="0,0,0,18"><StackPanel><TextBlock x:Name="PageTitle" Text="Dashboard" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Transparent controls for offline and story-mode play" Foreground="{StaticResource MutedBrush}"/></StackPanel><Border x:Name="SafetyPill" DockPanel.Dock="Right" Background="#26314A" CornerRadius="12" Padding="12,6"><TextBlock Text="VISION SAFE / OFF" Foreground="#C9D2E8"/></Border></DockPanel>
   <Grid Grid.Row="1">
    <ScrollViewer x:Name="DashboardPage"><WrapPanel><Border Style="{StaticResource Card}" Width="420"><StackPanel><TextBlock Text="Quick start" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="1  Connect DualSense by USB or Bluetooth&#x0a;2  Install ViGEmBus for virtual Xbox output&#x0a;3  Start Controller and verify Monitor&#x0a;4  Configure Vision only for offline games" Foreground="{StaticResource MutedBrush}" Margin="0,12" LineHeight="24"/><CheckBox x:Name="MasterEnabled" Checked="MasterToggle" Unchecked="MasterToggle" Content="Controller processing enabled" IsChecked="True"/></StackPanel></Border><Border Style="{StaticResource Card}" Width="420"><StackPanel><TextBlock Text="Safety first" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Vision output requires: master enable, a selected display, the activation trigger, and a high-confidence hostile label. Unknown people are ignored." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12"/><Button Content="EMERGENCY DISABLE VISION" Background="#B83B5E" Click="DisableVision"/></StackPanel></Border></WrapPanel></ScrollViewer>
    <ScrollViewer x:Name="SticksPage" Visibility="Collapsed"><WrapPanel><Border Style="{StaticResource Card}" Width="430"><StackPanel><TextBlock Text="Right stick tuning" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Sensitivity"/><Slider x:Name="Sensitivity" Minimum="0.25" Maximum="2" Value="1" ValueChanged="SettingsChanged"/><TextBlock x:Name="SensitivityValue"/></StackPanel></Border><Border Style="{StaticResource Card}" Width="430"><StackPanel><TextBlock Text="Auto jitter" FontSize="19" FontWeight="SemiBold"/><CheckBox x:Name="JitterEnabled" Content="Enable small jitter while holding L2" Checked="SettingsChanged" Unchecked="SettingsChanged"/><TextBlock Text="Experimental oscillation; no verified aim-assist benefit. Disabled during Vision Aim. Release L2 to stop." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,8"/><ComboBox x:Name="JitterPatternBox" SelectionChanged="SettingsChanged"><ComboBoxItem Content="Circle" IsSelected="True"/><ComboBoxItem Content="Horizontal"/><ComboBoxItem Content="Vertical"/><ComboBoxItem Content="Random"/></ComboBox><TextBlock Text="Horizontal strength" Margin="0,10,0,0"/><Slider x:Name="JitterX" Minimum="0" Maximum="0.03" Value="0.005" ValueChanged="SettingsChanged"/><TextBlock x:Name="JitterXValue"/><TextBlock Text="Vertical strength"/><Slider x:Name="JitterY" Minimum="0" Maximum="0.03" Value="0.005" ValueChanged="SettingsChanged"/><TextBlock x:Name="JitterYValue"/><TextBlock Text="Frequency"/><Slider x:Name="JitterHz" Minimum="1" Maximum="30" Value="8" ValueChanged="SettingsChanged"/><TextBlock x:Name="JitterHzValue"/></StackPanel></Border></WrapPanel></ScrollViewer>
    <ScrollViewer x:Name="TurboPage" Visibility="Collapsed"><WrapPanel><Border Style="{StaticResource Card}" Width="430"><StackPanel><TextBlock Text="Turbo" FontSize="19" FontWeight="SemiBold"/><CheckBox x:Name="TurboEnabled" Checked="SettingsChanged" Unchecked="SettingsChanged" Content="Enable turbo"/><TextBlock Text="Button"/><ComboBox x:Name="TurboButton" SelectionChanged="SettingsChanged"><ComboBoxItem Content="A" IsSelected="True"/><ComboBoxItem Content="B"/><ComboBoxItem Content="X"/><ComboBoxItem Content="Y"/></ComboBox><TextBlock Text="Rate" Margin="0,10,0,0"/><Slider x:Name="TurboHz" ValueChanged="SettingsChanged" Minimum="2" Maximum="25" Value="10"/><TextBlock Text="Remapping uses profile JSON: source button → destination button." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,18,0,0"/></StackPanel></Border></WrapPanel></ScrollViewer>
    <ScrollViewer x:Name="VisionPage" Visibility="Collapsed"><WrapPanel><Border Style="{StaticResource Card}" Width="430"><StackPanel><TextBlock Text="Vision Aim" FontSize="22" FontWeight="SemiBold"/><Border Background="#3B1F2B" CornerRadius="8" Padding="12" Margin="0,10"><StackPanel><CheckBox x:Name="VisionEnabled" Content="MASTER ENABLE — hold L2 to activate" FontSize="15" FontWeight="SemiBold" Checked="VisionToggle" Unchecked="VisionToggle"/><TextBlock Text="Offline/story mode only. Release L2 to stop correction immediately." Foreground="#FFB4C7" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border><TextBlock Text="Game display (fullscreen borderless supported)"/><ComboBox x:Name="DisplayBox" Margin="0,5,0,10"/><TextBlock Text="Captures this display. Keep your game visible on it." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/><TextBlock Text="Person detector"/><ComboBox x:Name="DetectorPreset" SelectionChanged="DetectorPresetChanged" Margin="0,5,0,10"><ComboBoxItem Content="Stronger included ONNX detector" Tag="builtin:yolox-s" IsSelected="True"/><ComboBoxItem Content="Faster included ONNX detector" Tag="builtin:yolox-nano"/><ComboBoxItem Content="Custom YOLOv8 ONNX file" Tag="custom"/></ComboBox><StackPanel x:Name="CustomModelRow" Visibility="Collapsed"><TextBox x:Name="ModelPath" Text="builtin:yolox-s" Margin="0,5,0,10"/><Button Content="BROWSE CUSTOM YOLOv8 MODEL…" Click="BrowseModel" Background="#35415D"/></StackPanel><TextBlock Text="Both included options use ONNX. The stronger detector needs more processing time." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/><TextBlock Text="Aim point"/><ComboBox x:Name="AimPointBox" SelectionChanged="SettingsChanged"><ComboBoxItem Content="Head" IsSelected="True"/><ComboBoxItem Content="UpperTorso"/><ComboBoxItem Content="CenterMass"/></ComboBox><CheckBox x:Name="DebugOverlay" Content="Show FOV, boxes, aim point, target and confidence" IsChecked="True"/><Button Content="APPLY / RESTART VISION" Click="RestartVision"/></StackPanel></Border><Border Style="{StaticResource Card}" Width="430"><StackPanel><TextBlock Text="Aim movement" FontSize="19" FontWeight="SemiBold"/><CheckBox x:Name="StrongTargetFollow" Content="Strong target follow (offline)" Checked="SettingsChanged" Unchecked="SettingsChanged" Margin="0,10,0,0"/><TextBlock Text="Faster acquisition and stronger pull near the aim point. Hold L2; release to take full control." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/><TextBlock Text="Strength" Margin="0,12,0,0"/><Slider x:Name="AimStrength" ValueChanged="SettingsChanged" Minimum="0" Maximum="1" Value="0.65"/><TextBlock Text="Above 65%, pull increases rapidly. Maximum allows full stick correction; reduce it if aim overshoots." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/><TextBlock Text="Smoothness" Margin="0,14,0,0"/><Slider x:Name="Smoothing" ValueChanged="SettingsChanged" Minimum="0" Maximum="1" Value="0.55"/><TextBlock Text="Higher smoothness eases movement more gradually; lower reacts faster. Release L2 to stop." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/><TextBlock x:Name="AimOutputStatus" Text="Start controller to verify game output." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,16"/><Expander x:Name="AdvancedVision" Header="Advanced detection settings" Foreground="{StaticResource TextBrush}" IsExpanded="False"><StackPanel Margin="0,8"><TextBlock Text="Person confidence"/><Slider x:Name="DetectionConfidence" ValueChanged="SettingsChanged" Minimum="0.2" Maximum="0.95" Value="0.55"/><TextBlock Text="Crosshair FOV radius"/><TextBlock Text="For small distant people, try a smaller radius: it enlarges the captured area for detection, but you must aim closer to the person. Distance in meters cannot be measured." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/><Slider x:Name="FovRadius" ValueChanged="SettingsChanged" Minimum="0.05" Maximum="0.4" Value="0.2"/></StackPanel></Expander><TextBlock Text="Recognizes visible people, including teammates. It cannot see through walls. A red box marks the selected target, not confirmed game movement." Foreground="#FBBF24" TextWrapping="Wrap" Margin="0,14,0,0"/></StackPanel></Border></WrapPanel></ScrollViewer>
    <ScrollViewer x:Name="MonitorPage" Visibility="Collapsed"><WrapPanel><Border Style="{StaticResource Card}" Width="430"><StackPanel><TextBlock Text="Live controller" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="MonitorText" Text="Waiting for input…" FontFamily="Cascadia Mono" Foreground="{StaticResource MutedBrush}" Margin="0,12"/></StackPanel></Border><Border Style="{StaticResource Card}" Width="430"><StackPanel><TextBlock Text="Vision diagnostics" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="VisionText" Text="Vision is disabled" FontFamily="Cascadia Mono" Foreground="{StaticResource MutedBrush}" Margin="0,12" TextWrapping="Wrap"/></StackPanel></Border></WrapPanel></ScrollViewer>
    <ScrollViewer x:Name="ProfilesPage" Visibility="Collapsed"><WrapPanel><Border Style="{StaticResource Card}" Width="500"><StackPanel><TextBlock Text="Profiles" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Profile name"/><TextBox x:Name="ProfileName" Text="Default" Margin="0,6,0,10"/><WrapPanel><Button Content="SAVE PROFILE" Click="SaveProfile"/><Button Content="LOAD PROFILE" Background="#35415D" Click="LoadProfile"/></WrapPanel><TextBlock Text="Profiles are stored locally under your application data folder." Foreground="{StaticResource MutedBrush}" Margin="0,10"/></StackPanel></Border></WrapPanel></ScrollViewer>
   </Grid>
  </Grid>
 </Grid>
</Window>
