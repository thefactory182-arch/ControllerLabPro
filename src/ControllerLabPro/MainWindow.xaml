<Window x:Class="ControllerLabPro.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ControllerLab Pro" Width="1220" Height="780" MinWidth="980" MinHeight="650" WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#0E1527"><DockPanel Margin="18"><StackPanel DockPanel.Dock="Top"><TextBlock Text="CONTROLLERLAB" FontWeight="Bold" FontSize="20"/><TextBlock Text="PRO • OFFLINE LAB" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,2,0,28"/>
   <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0" Foreground="White" SelectionChanged="NavChanged"><ListBoxItem Content="Dashboard" Padding="12" IsSelected="True"/><ListBoxItem Content="Sticks &amp; Jitter" Padding="12"/><ListBoxItem Content="Turbo &amp; Remap" Padding="12"/><ListBoxItem Content="Vision Aim" Padding="12"/><ListBoxItem Content="Monitor" Padding="12"/><ListBoxItem Content="Profiles" Padding="12"/></ListBox>
  </StackPanel><StackPanel DockPanel.Dock="Bottom"><TextBlock x:Name="InputStatus" Text="DualSense: disconnected" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4"/><TextBlock x:Name="OutputStatus" Text="Game output: disconnected" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4"/><Button x:Name="ControllerButton" Content="START CONTROLLER" Click="StartController" Margin="0,12,0,0"/></StackPanel></DockPanel></Border>
  <Grid Grid.Column="1" Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><DockPanel Margin="0,0,0,18"><StackPanel><TextBlock x:Name="PageTitle" Text="Dashboard" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Transparent controls for offline and story-mode play" Foreground="{StaticResource MutedBrush}"/></StackPanel><Border x:Name="SafetyPill" DockPanel.Dock="Right" Background="#26314A" CornerRadius="12" Padding="12,6"><TextBlock Text="VISION SAFE / OFF" Foreground="#C9D2E8"/></Border></DockPanel>
   <Grid Grid.Row="1">
    <ScrollViewer x:Name="DashboardPage"><WrapPanel><Border Style="{StaticResource Card}" Width="420"><StackPanel><TextBlock Text="Quick start" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="1  Connect DualSense by USB or Bluetooth&#x0a;2  Install ViGEmBus for virtual Xbox output&#x0a;3  Start Controller and verify Monitor&#x0a;4  Configure Vision only for offline games" Foreground="{StaticResource MutedBrush}" Margin="0,12" LineHeight="24"/><CheckBox x:Name="MasterEnabled" Checked="MasterToggle" Unchecked="MasterToggle" Content="Controller processing enabled" IsChecked="True"/></StackPanel></Border><Border Style="{StaticResource Card}" Width="420"><StackPanel><TextBlock Text="Safety first" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Vision output requires: master enable, a selected display, the activation trigger, and a high-confidence hostile label. Unknown people are ignored." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12"/><Button Content="EMERGENCY DISABLE VISION" Background="#B83B5E" Click="DisableVision"/></StackPanel></Border></WrapPanel></ScrollViewer>
    <ScrollViewer x:Name="SticksPage" Visibility="Collapsed"><WrapPanel><Border Style="{StaticResource Card}" Width="430"><StackPanel><TextBlock Text="Right stick tuning" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Deadzone"/><Slider x:Name="Deadzone" Minimum="0" Maximum="0.3" Value="0.06" ValueChanged="SettingsChanged"/><TextBlock x:Name="DeadzoneValue"/><TextBlock Text="Sensitivity"/><Slider x:Name="Sensitivity" Minimum="0.25" Maximum="2" Value="1" ValueChanged="SettingsChanged"/><TextBlock x:Name="SensitivityValue"/><TextBlock Text="Anti-deadzone"/><Slider x:Name="AntiDeadzone" Minimum="0" Maximum="0.25" Value="0.02" ValueChanged="SettingsChanged"/><TextBlock x:Name="AntiDeadzoneValue"/></StackPanel></Border><Border Style="{StaticResource Card}" Width="430"><StackPanel><TextBlock Text="Auto jitter" FontSize="19" FontWeight="SemiBold"/><CheckBox x:Name="JitterEnabled" Content="Enable jitter" Checked="SettingsChanged" Unchecked="SettingsChanged"/><ComboBox x:Name="JitterPatternBox" SelectionChanged="SettingsChanged"><ComboBoxItem Content="Circle" IsSelected="True"/><ComboBoxItem Content="Horizontal"/><ComboBoxItem Content="Vertical"/><ComboBoxItem Content="Random"/></ComboBox><TextBlock Text="Horizontal strength" Margin="0,10,0,0"/><Slider x:Name="JitterX" Minimum="0" Maximum="0.3" Value="0.05" ValueChanged="SettingsChanged"/><TextBlock x:Name="JitterXValue"/><TextBlock Text="Vertical strength"/><Slider x:Name="JitterY" Minimum="0" Maximum="0.3" Value="0.04" ValueChanged="SettingsChanged"/><TextBlock x:Name="JitterYValue"/><TextBlock Text="Frequency"/><Slider x:Name="JitterHz" Minimum="1" Maximum="30" Value="8" ValueChanged="SettingsChanged"/><TextBlock x:Name="JitterHzValue"/></StackPanel></Border></WrapPanel></ScrollViewer>
    <ScrollViewer x:Name="TurboPage" Visibility="Collapsed"><WrapPanel><Border Style="{StaticResource Card}" Width="430"><StackPanel><TextBlock Text="Turbo" FontSize="19" FontWeight="SemiBold"/><CheckBox x:Name="TurboEnabled" Checked="SettingsChanged" Unchecked="SettingsChanged" Content="Enable turbo"/><TextBlock Text="Button"/><ComboBox x:Name="TurboButton" SelectionChanged="SettingsChanged"><ComboBoxItem Content="A" IsSelected="True"/><ComboBoxItem Content="B"/><ComboBoxItem Content="X"/><ComboBoxItem Content="Y"/></ComboBox><TextBlock Text="Rate" Margin="0,10,0,0"/><Slider x:Name="TurboHz" ValueChanged="SettingsChanged" Minimum="2" Maximum="25" Value="10"/><TextBlock Text="Remapping uses profile JSON: source button → destination button." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,18,0,0"/></StackPanel></Border></WrapPanel></ScrollViewer>
    <ScrollViewer x:Name="VisionPage" Visibility="Collapsed"><WrapPanel><Border Style="{StaticResource Card}" Width="430"><StackPanel><TextBlock Text="Vision Aim" FontSize="22" FontWeight="SemiBold"/><Border Background="#3B1F2B" CornerRadius="8" Padding="12" Margin="0,10"><StackPanel><CheckBox x:Name="VisionEnabled" Content="MASTER ENABLE — hold L2 to activate" FontSize="15" FontWeight="SemiBold" Checked="VisionToggle" Unchecked="VisionToggle"/><TextBlock Text="Offline/story mode only. Release L2 to stop correction immediately." Foreground="#FFB4C7" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border><TextBlock Text="Game display (fullscreen borderless supported)"/><ComboBox x:Name="DisplayBox" Margin="0,5,0,10"/><TextBlock Text="Captures this display. Keep your game visible on it." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/><TextBlock Text="YOLO ONNX person model"/><TextBox x:Name="ModelPath" Text="models/yolov8n.onnx" Margin="0,5,0,10"/><Button Content="BROWSE MODEL…" Click="BrowseModel" Background="#35415D"/><TextBlock Text="Requires a YOLOv8 ONNX person model; a model is not bundled." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/><TextBlock Text="Aim point"/><ComboBox x:Name="AimPointBox" SelectionChanged="SettingsChanged"><ComboBoxItem Content="Head" IsSelected="True"/><ComboBoxItem Content="UpperTorso"/><ComboBoxItem Content="CenterMass"/></ComboBox><CheckBox x:Name="DebugOverlay" Content="Show FOV, boxes, aim point, target and confidence" IsChecked="True"/><Button Content="APPLY / RESTART VISION" Click="RestartVision"/></StackPanel></Border><Border Style="{StaticResource Card}" Width="430"><StackPanel><TextBlock Text="Selection &amp; movement" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Person confidence"/><Slider x:Name="DetectionConfidence" ValueChanged="SettingsChanged" Minimum="0.2" Maximum="0.95" Value="0.55"/><TextBlock Text="Crosshair FOV radius"/><Slider x:Name="FovRadius" ValueChanged="SettingsChanged" Minimum="0.05" Maximum="0.4" Value="0.2"/><TextBlock Text="Aim strength"/><Slider x:Name="AimStrength" ValueChanged="SettingsChanged" Minimum="0.05" Maximum="1" Value="0.75"/><TextBlock Text="Smoothing"/><Slider x:Name="Smoothing" ValueChanged="SettingsChanged" Minimum="0" Maximum="0.98" Value="0.82"/><TextBlock Text="Maximum stick correction speed"/><Slider x:Name="MaxAimSpeed" ValueChanged="SettingsChanged" Minimum="0.02" Maximum="0.7" Value="0.25"/><TextBlock Text="Target lock persistence (ms)"/><Slider x:Name="LockMilliseconds" ValueChanged="SettingsChanged" Minimum="0" Maximum="1000" Value="300"/><TextBlock Text="Release after missed frames"/><Slider x:Name="ReleaseMisses" ValueChanged="SettingsChanged" Minimum="1" Maximum="12" Value="3" TickFrequency="1" IsSnapToTickEnabled="True"/><TextBlock Text="Friendly-target warning: a person/head detector cannot tell teammates from enemies. Crosshair-local activation reduces this risk but does not eliminate it." Foreground="#FBBF24" TextWrapping="Wrap" Margin="0,14,0,0"/></StackPanel></Border></WrapPanel></ScrollViewer>
    <ScrollViewer x:Name="MonitorPage" Visibility="Collapsed"><WrapPanel><Border Style="{StaticResource Card}" Width="430"><StackPanel><TextBlock Text="Live controller" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="MonitorText" Text="Waiting for input…" FontFamily="Cascadia Mono" Foreground="{StaticResource MutedBrush}" Margin="0,12"/></StackPanel></Border><Border Style="{StaticResource Card}" Width="430"><StackPanel><TextBlock Text="Vision diagnostics" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="VisionText" Text="Vision is disabled" FontFamily="Cascadia Mono" Foreground="{StaticResource MutedBrush}" Margin="0,12" TextWrapping="Wrap"/></StackPanel></Border></WrapPanel></ScrollViewer>
    <ScrollViewer x:Name="ProfilesPage" Visibility="Collapsed"><WrapPanel><Border Style="{StaticResource Card}" Width="500"><StackPanel><TextBlock Text="Profiles" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Profile name"/><TextBox x:Name="ProfileName" Text="Default" Margin="0,6,0,10"/><WrapPanel><Button Content="SAVE PROFILE" Click="SaveProfile"/><Button Content="LOAD PROFILE" Background="#35415D" Click="LoadProfile"/></WrapPanel><TextBlock Text="Profiles are stored locally under your application data folder." Foreground="{StaticResource MutedBrush}" Margin="0,10"/></StackPanel></Border></WrapPanel></ScrollViewer>
   </Grid>
  </Grid>
 </Grid>
</Window>
